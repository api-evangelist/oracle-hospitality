            ],
            "params": [
              {
                "name": "reservationId",
                "value": "",
                "type": "path",
                "description": "A unique OPERA Cloud confirmation number or reservation ID is used to locate a reservation in OPERA Cloud. This ID serves as the primary identifier for a reservation in OPERA Cloud."
              },

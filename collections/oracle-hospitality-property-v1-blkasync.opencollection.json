          "info": {
            "name": "This API facilitates fetching block allocation summary for a Hotel.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/externalSystems/:extSystemCode/hotels/:hotelId/blocks/allocationSummary",
            "headers": [
              {
                "name": "authorization",
                "value": ""
              },
              {
                "name": "externalData",
                "value": ""
              },
              {
                "name": "x-app-key",
                "value": ""
              },
              {
                "name": "x-request-id",
                "value": ""
              },
              {
                "name": "x-originating-application",
                "value": ""
              },
              {
                "name": "x-hotelid",
                "value": ""
              },
              {
                "name": "Accept-Language",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "hotelId",
                "value": "",
                "type": "path"
              },
              {
                "name": "extSystemCode",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "This API will fetch Block allocation information for a hotel, and specified date range. The block allocated inventory, rates and room type statistics are returned as part of the response. The maximum limit of date range (whether using start/endDate or startLastModifiedDate/endLastModifiedDate) is 94 days, but the recommendation is to use a date range proportionate to the size of the hotel.   Every identical request (employing the same query parameters) for the getBlockAllocationSummary operation"
        },

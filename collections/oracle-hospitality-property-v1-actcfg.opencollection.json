                "value": ""
              },
              {
                "name": "x-externalsystem",
                "value": ""
              },
              {
                "name": "Accept-Language",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Indicates maximum number of records a Web Service should return."
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Index or initial index of the set(page) being requested. If the index goes out of the bounds of the total set count then no data will be returned."
              },
              {
                "name": "fetchInactive",
                "value": "",
                "type": "query",
                "description": "Determines wether to fetch inactive records or not."
              },
              {
                "name": "codes",
                "value": "",
                "type": "query",
                "description": "Codes to be searched."
              },
              {
                "name": "wildCard",
                "value": "",
                "type": "query",
                "description": "Wildcard search on the code."
              },
              {
                "name": "description",
                "value": "",
                "type": "query",
                "description": "Description of the code."
              }
            ]
          },
          "docs": "Retrieve a list of all configured Activity Result codes and descriptions.  Activity Results appear on the Activities screen in the Results field after the Activity is completed.  And example could be Call Again - an activity is Completed but the result code as part of the completion is to Call Again. <p><strong>OperationId:</strong>getActivityResultsConfig</p> <p>The maximum allowable limit for this API is <strong>25</strong>.</p>"
        },
        {
          "info": {
            "name": "Create an Activity results code",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/activityResults",
